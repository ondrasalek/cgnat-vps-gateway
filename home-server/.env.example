# =============================================================================
# Home Server Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values.
# DO NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Timezone for container logs
TZ=UTC

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# VPS public IP address (WireGuard endpoint)
VPS_PUBLIC_IP=203.0.113.10

# VPS WireGuard port
VPS_WG_PORT=51820

# WireGuard interface IP on home server
WG_HOME_IP=10.8.0.2

# WireGuard interface IP on VPS
WG_VPS_IP=10.8.0.1

# -----------------------------------------------------------------------------
# Application Ports
# -----------------------------------------------------------------------------
# These are the ports your applications listen on locally

# Immich (photo management) - default port
IMMICH_PORT=2283

# Jellyfin (media server) - uncomment if used
# JELLYFIN_PORT=8096

# Nextcloud (file sync) - uncomment if used
# NEXTCLOUD_PORT=8080

# Home Assistant - uncomment if used
# HOMEASSISTANT_PORT=8123

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Add any application-specific environment variables below

# Example for Immich:
# UPLOAD_LOCATION=/path/to/photos
# DB_PASSWORD=your-database-password
