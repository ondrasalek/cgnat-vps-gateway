# =============================================================================
# VPS Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values.
# DO NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Timezone for container logs
TZ=UTC

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------

# Your domain managed by Cloudflare
DOMAIN=example.com

# Subdomain for the application (e.g., app.example.com)
APP_SUBDOMAIN=app

# Full application URL (used by some applications)
APP_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# VPS public IP address
VPS_PUBLIC_IP=203.0.113.10

# WireGuard interface IP on VPS
WG_VPS_IP=10.8.0.1

# WireGuard interface IP on home server
WG_HOME_IP=10.8.0.2

# WireGuard listen port on VPS
WG_PORT=51820

# -----------------------------------------------------------------------------
# Application Ports
# -----------------------------------------------------------------------------
# These ports are used by socat to bridge traffic to the home server

# Immich (photo management)
IMMICH_PORT=2283

# Jellyfin (media server) - uncomment if used
# JELLYFIN_PORT=8096

# Nextcloud (file sync) - uncomment if used
# NEXTCLOUD_PORT=8080

# -----------------------------------------------------------------------------
# Cloudflare Configuration (Optional - for API-based operations)
# -----------------------------------------------------------------------------
# These are only needed if using Traefik's Cloudflare DNS challenge
# For manual certificate installation, these are not required

# Cloudflare API token with Zone:DNS:Edit permissions
# CF_API_TOKEN=your-cloudflare-api-token

# Cloudflare Zone ID (found in domain overview)
# CF_ZONE_ID=your-zone-id
